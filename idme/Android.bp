cc_binary {
    name: "fireos.hardware.idme@1.1-service",
    defaults: ["hidl_defaults"],
    init_rc: ["fireos.hardware.idme@1.1-service.rc"],
    vintf_fragments: ["fireos.hardware.idme@1.1-service.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "Idme.cpp",
        "IdmeProc.cpp",
        "IdmeStore.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "fireos.hardware.idme@1.0",
        "fireos.hardware.idme@1.1",
        "libbase",
        "libhidlbase",
        "libutils",
    ],
}
