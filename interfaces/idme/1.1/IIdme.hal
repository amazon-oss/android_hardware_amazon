package fireos.hardware.idme@1.1;

import @1.0::IIdme;

interface IIdme extends @1.0::IIdme {
    getUnlockCode() generates (IdmeStatus status, vec<uint8_t> unlockCode);
    getUnlockVersion() generates (IdmeStatus status, vec<uint8_t> unlockVersion);
};
