package fireos.hardware.amazonhmod@1.0;

import IAmazonHmodCallback;

interface IAmazonHmod {
    getHmodState() generates (HmodState state);
    registerHmodCallback(IAmazonHmodCallback callback);
    unregisterHmodCallback(IAmazonHmodCallback callback);
};
