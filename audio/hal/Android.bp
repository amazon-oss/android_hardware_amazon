cc_library_shared {
    name: "audio.primary.amazon_wrapper",
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "asp.cpp",
        "audio_hw.cpp",
        "audio_stream.cpp",
    ],
    shared_libs: [
        "libcutils",
        "libhardware",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror", "-Wno-unused-parameter"],
}

cc_library_shared {
    name: "audio.primary.mt8183",
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "32",
    srcs: [
        "asp.cpp",
        "audio_hw_p.cpp",
        "audio_stream_p.cpp",
    ],
    shared_libs: [
        "libhardware",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror", "-Wno-unused-parameter"],
}
