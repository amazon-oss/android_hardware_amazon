cc_defaults {
    name: "audio_amazon_wrapper_defaults",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["asp.cpp"],
    shared_libs: [
        "libcutils",
        "libhardware",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror", "-Wno-unused-parameter"],
}

cc_library_shared {
    name: "audio.primary.amazon_wrapper",
    defaults: ["audio_amazon_wrapper_defaults"],
    srcs: [
        "legacy/audio_hw.cpp",
        "legacy/audio_stream.cpp",
    ],
}

cc_library_shared {
    name: "audio.primary.amazon_wrapper_v28",
    defaults: ["audio_amazon_wrapper_defaults"],
    compile_multilib: "32",
    srcs: [
        "v28/audio_hw.cpp",
        "v28/audio_stream.cpp",
    ],
}
